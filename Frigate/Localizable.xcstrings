      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigate weigerde de configuratie"
          }
        }
      }
    },
    "Frigate starts the camera at once; no restart needed. The camera's password is kept in Frigate's config, as with Frigate's own wizard.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigate start de camera meteen, zonder herstart. Het wachtwoord van de camera komt in de configuratie van Frigate te staan, net als bij de wizard van Frigate zelf."
          }
        }
      }
    },
