    "A profile changes several cameras at once, for instance the indoor cameras off while you are home.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel verandert meerdere camera's tegelijk, bijvoorbeeld de binnencamera's uit als je thuis bent."
          }
        }
      }
    },
    "A profile with this name already exists.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een profiel met deze naam."
          }
        }
      }
    },
    "A tile plays live video while its camera sees motion or an object, and a picture otherwise.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tegel speelt live video zolang de camera beweging of een object ziet, en anders een foto."
          }
        }
      }
    },
