        }
      }
    },
    "%@: address changed": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: adres gewijzigd"
          }
        }
      }
    },
    "%@: roles changed": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: rollen gewijzigd"
          }
        }
      }
    },
    "%@ added": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toegevoegd"
          }
        }
      }
    },
    "The camera needs at least one stream with a role.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera heeft minstens één stream met een rol nodig."
          }
        }
      }
    },
    "A stream without go2rtc needs a role.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stream zonder go2rtc heeft een rol nodig."
          }
        }
      }
    },
    "A stream's password comes from a variable ({FRIGATE_…}). Change these streams in Configuration (YAML).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord van een stream komt uit een variabele ({FRIGATE_…}). Pas deze streams aan in Configuratie (YAML)."
          }
        }
      }
    },
    "Not saved yet": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet bewaard"
          }
        }
      }
    },
    "go2rtc reads its streams when it starts, so Frigate restarts.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "go2rtc leest zijn streams bij het starten, dus Frigate herstart."
          }
        }
      }
    },
    "This needs Frigate 0.17 or later. Change the streams in Configuration (YAML).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is Frigate 0.17 of nieuwer nodig. Pas de streams aan in Configuratie (YAML)."
          }
        }
      }
    },
    "Saved. Frigate has restarted.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard. Frigate is herstart."
          }
        }
      }
    },
    "Give the stream a name.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de stream een naam."
          }
        }
      }
    },
    "Use letters, digits, - and _ only.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik alleen letters, cijfers, - en _."
          }
        }
      }
    },
    "Another stream already has this name.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere stream heeft al deze naam."
          }
        }
      }
    },
