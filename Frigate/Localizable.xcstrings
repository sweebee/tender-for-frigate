      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "oprit_sub"
          }
        }
      }
    },
    "Address %lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres %lld"
          }
        }
      }
    },
    "%@ also uses this stream; its name and address stay as they are here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gebruikt deze stream ook; naam en adres blijven daarom hier zoals ze zijn."
          }
        }
      }
    },
    "This address uses a variable or a special source. Change it in Configuration (YAML).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres gebruikt een variabele of een speciale bron. Pas het aan in Configuratie (YAML)."
          }
        }
      }
    },
    "Renaming %@ also changes the camera's input and its live view %@.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemen van %1$@ past ook de camera-input en liveweergave %2$@ aan."
          }
        }
      }
    },
    "The camera's address is filled in; add the path of the stream.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres van de camera staat er al; vul het pad van de stream aan."
          }
        }
      }
    },
    "Roles": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollen"
          }
        }
      }
    },
    "Choosing a role takes it from the other stream. Without a role the stream is for live view only.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rol kiezen haalt hem weg bij de andere stream. Zonder rol is de stream alleen voor liveweergave."
          }
        }
      }
    },
    "Choosing a role takes it from the other stream. A stream without go2rtc needs a role.": {
      "localizations": {
