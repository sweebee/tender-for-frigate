            "state": "translated",
            "value": "10 seconden vooruit"
          }
        }
      }
    },
    "Frames before it counts": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beelden voordat het telt"
          }
        }
      }
