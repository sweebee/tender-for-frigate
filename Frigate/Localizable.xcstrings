    "Always the lighter stream, a bit less sharp. Opening a camera still switches to its own stream.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd de lichtere stream, iets minder scherp. Een camera openen schakelt nog steeds naar zijn eigen stream."
          }
        }
      }
    },
    "Always the sharpest picture. Uses the most data and battery.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd het scherpste beeld. Kost de meeste data en batterij."
